{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "doogle.html",
        "title": "두글",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 19 },
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "fileAssociations": [
      {
        "ext": ["hwp"],
        "name": "HWP document",
        "description": "한글 문서",
        "role": "Editor"
      },
      {
        "ext": ["hwpx"],
        "name": "HWPX document",
        "description": "한글 문서 (HWPX)",
        "role": "Editor"
      }
    ]
  }
}
